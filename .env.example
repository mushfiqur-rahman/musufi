# Musufi environment variables.
# Copy to .env.local for local development and fill in the values.
# On Hostinger: hPanel → your Node.js app → Environment variables, one entry per
# name below, then redeploy. An uploaded .env file is NOT read by the live app.
# Never commit real values.

# --- MySQL database (hPanel → Databases → Management) ---
# On Hostinger itself: usually "localhost". On your PC: the Remote MySQL hostname
# shown in hPanel (e.g. srv1234.hstgr.io) — your IP must be allowed there first.
DB_HOST=
DB_PORT=3306
# Hostinger adds a prefix, e.g. u922064030_musufi
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Login sessions ---
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Admin ---
# Email addresses that can open /admin (they log in with an email code), comma-separated.
ADMIN_EMAILS=

# --- Email (Hostinger SMTP) ---
# Sends order alerts to ORDER_ALERT_EMAIL and, later, login codes to customers.
# Required: SMTP_USER, SMTP_PASSWORD, ORDER_ALERT_EMAIL.
# SMTP_USER is the full mailbox address, e.g. orders@musufi.com (create it in hPanel → Emails).
# SMTP_HOST and SMTP_PORT are optional; they default to smtp.hostinger.com and 465.
SMTP_USER=
SMTP_PASSWORD=
ORDER_ALERT_EMAIL=
